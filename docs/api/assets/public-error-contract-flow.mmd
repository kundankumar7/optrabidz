flowchart TB
    accTitle: Public error contract publication architecture
    accDescr: Module, framework, and security definitions are normalized and deduplicated, filtered by a fail-closed exposure policy, published to OpenAPI and Markdown, and checked for parity, inventory, exposure, and disclosure.

    subgraph SOURCES["1. Owned public definitions"]
        direction TB
        Module["Module error catalogues"]
        Framework["Framework problem definitions"]
        Security["Security problem definitions"]
        Module ~~~ Framework ~~~ Security
    end

    subgraph ADAPTER["2. Documentation adapter"]
        direction TB
        Normalize["Normalize public contract"] --> Validate["Validate conflicts and deduplicate"]
    end

    Policy["3. Fail-closed exposure policy"]

    subgraph OUTPUTS["4. Published contracts"]
        direction TB
        OpenApi["OpenAPI schemas and reusable responses"]
        Markdown["Markdown catalogue with one row per code"]
        OpenApi ~~~ Markdown
    end

    Tests["5. Parity, inventory, exposure, and disclosure verification"]

    Module --> Normalize
    Framework --> Normalize
    Security --> Normalize
    Validate --> Policy
    Policy --> OpenApi
    Policy --> Markdown
    OpenApi -. "generated contract" .-> Tests
    Markdown -. "checked-in snapshot" .-> Tests

    classDef source fill:#EFF6FF,stroke:#2563EB,color:#0F172A,stroke-width:2px;
    classDef adapter fill:#FFF7ED,stroke:#EA580C,color:#7C2D12,stroke-width:2px;
    classDef output fill:#ECFDF5,stroke:#059669,color:#064E3B,stroke-width:2px;
    classDef security fill:#FEF2F2,stroke:#DC2626,color:#7F1D1D,stroke-width:2px;
    class Module,Framework,Security source;
    class Normalize,Validate adapter;
    class OpenApi,Markdown,Tests output;
    class Policy security;
