flowchart TB
    subgraph UserBoundary[Authenticated financial API]
        direction LR
        U[Authenticated caller] --> S[Spring Security]
        S --> C[Financial controller]
    end

    subgraph ProviderBoundary[Payment-provider webhook boundary]
        direction TB
        P[Payment provider] --> B[Bounded exact raw bytes]
        B --> V{Provider verifier\nsignature + timestamp}
        V -->|rejected| R[Uniform safe 400\nPAYMENT_WEBHOOK_REJECTED]
        V -->|verified| J[Parse allowlisted event]
        J -->|invalid| Q[Safe 400\nPAYMENT_WEBHOOK_PAYLOAD_INVALID]
        J -->|valid| I{Persistent event identity}
        I -->|duplicate| A[Minimal 2xx acknowledgement]
    end

    F[Financial use case]
    C --> F
    I -->|first delivery| F
    F --> G{Ownership, role,\nand state decision}
    G -->|expected failure| E[Financial ApplicationException]
    E --> H[Shared REST adapter]
    H --> D[Safe RFC 9457 Problem Details]
    G -->|allowed| T[Conditional state transition]
    T --> DB[(PostgreSQL)]
    T --> O[Outbox event]
    T --> L[Sanitized audit event]
    T -->|webhook| A
    T -->|user request| US[Financial API success]

    CFG[Safe configuration\nexplicit dev profile\nfail-fast provider secrets]
    CFG -. constrains .-> B
    CFG -. constrains .-> V
