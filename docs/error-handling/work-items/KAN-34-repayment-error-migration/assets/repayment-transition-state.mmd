flowchart TB
    accTitle: Repayment transition state classification
    accDescr: An authorized repayment operation handles existing intents idempotently, performs a state-qualified atomic update, and classifies zero-row races from trusted reloaded state.

    subgraph PRECHECK[1. Precondition]
        direction LR
        A[Authorized repayment operation] --> P{Initially payable?}
        P -->|No| N[409 installment not payable]
        P -->|Yes| I{Active intent exists?}
        I -->|Yes| S[Idempotent success; no duplicate effects]
    end

    subgraph WRITE[2. Atomic write]
        direction LR
        I -->|No| U[State-qualified installment update]
        U -->|One row| E[Commit one repayment event]
        U -->|Zero rows| R[Reload trusted installment state]
    end

    subgraph CLASSIFY[3. Race classification]
        direction LR
        R --> C{Observed result}
        C -->|Same intent| S2[Idempotent success; no duplicate effects]
        C -->|Competing state| X[409 conflict; roll back]
        C -->|Missing internally| M[404; roll back]
    end

    classDef error fill:#FEF2F2,stroke:#DC2626,color:#7F1D1D,stroke-width:2px;
    classDef success fill:#ECFDF5,stroke:#059669,color:#064E3B,stroke-width:2px;
    class N,X,M error;
    class E,S,S2 success;
