%%{init: {"theme":"base","themeVariables":{"fontSize":"22px","fontFamily":"Arial, sans-serif","primaryColor":"#EFF6FF","primaryTextColor":"#0F172A","primaryBorderColor":"#2563EB","lineColor":"#334155","secondaryColor":"#F8FAFC","tertiaryColor":"#FEF2F2","clusterBkg":"#FFFFFF","clusterBorder":"#94A3B8","edgeLabelBackground":"#FFFFFF"},"flowchart":{"htmlLabels":false,"curve":"linear","nodeSpacing":45,"rankSpacing":55}}}%%
flowchart TB
    subgraph REQUEST[1. Request boundary]
        direction LR
        U[Authenticated caller] --> S[Spring Security]
        S --> C[Financial API adapter]
        C --> V{Valid query shape?}
        V -->|No| E1[400 framework validation]
    end

    subgraph AUTHORITY[2. Authority before state]
        direction LR
        V -->|Yes| R{Role allowed?}
        R -->|No| E2[403 operation denied]
        R -->|Yes| Q[Global or participant-scoped lookup]
        Q --> F{Resource found?}
        F -->|No| E3[404 missing or non-owned]
    end

    subgraph BUSINESS[3. Financial decision]
        direction LR
        F -->|Yes| P{Initially payable?}
        P -->|No| E4[409 not payable]
        P -->|Yes| T[Conditional PostgreSQL transition]
        T --> O[Success or 409 race conflict]
    end

    classDef error fill:#FEF2F2,stroke:#DC2626,color:#7F1D1D,stroke-width:2px;
    classDef success fill:#ECFDF5,stroke:#059669,color:#064E3B,stroke-width:2px;
    class E1,E2,E3,E4 error;
    class O success;
