{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:optrabidz:design-tokens:manifest-schema:1",
  "title": "OptraBidz token manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dtcgVersion",
    "schemaUrn",
    "normativeSource",
    "projectSchema",
    "baseSources",
    "themes",
    "allowedOverlayRoots",
    "contracts",
    "outputs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dtcgVersion": { "const": "2025.10" },
    "schemaUrn": { "const": "urn:optrabidz:design-tokens:schema:2025.10" },
    "normativeSource": { "const": "https://www.designtokens.org/tr/2025.10/format/" },
    "projectSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "checksum"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "checksum": { "type": "string", "pattern": "^sha256:.+" }
      }
    },
    "baseSources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/relativePath" }
    },
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/definitions/relativePath" },
        "dark": { "$ref": "#/definitions/relativePath" }
      }
    },
    "allowedOverlayRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$" }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessibility", "status", "elevation"],
      "properties": {
        "accessibility": { "$ref": "#/definitions/relativePath" },
        "status": { "$ref": "#/definitions/relativePath" },
        "elevation": { "$ref": "#/definitions/relativePath" }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["css"],
      "properties": {
        "css": { "$ref": "#/definitions/relativePath" }
      }
    }
  },
  "definitions": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/])" }
    }
  }
}
