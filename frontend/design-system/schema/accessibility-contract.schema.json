{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:optrabidz:design-tokens:accessibility-contract:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contrastPairs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contrastPairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "foreground", "background", "category", "minimum", "themes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "foreground": { "type": "string", "minLength": 1 },
          "background": { "type": "string", "minLength": 1 },
          "category": { "enum": ["normalText", "largeText", "nonText"] },
          "minimum": { "type": "number", "minimum": 1 },
          "themes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["light", "dark"] }
          }
        }
      }
    }
  }
}
