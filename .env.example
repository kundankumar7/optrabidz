# Local development database
OPTRABIDZ_DATASOURCE_URL=jdbc:postgresql://localhost:5432/optrabidz
OPTRABIDZ_DATASOURCE_USERNAME=postgres
OPTRABIDZ_DATASOURCE_PASSWORD=

# First administrator provisioning (enable for one startup only)
OPTRABIDZ_ADMIN_BOOTSTRAP_ENABLED=false
OPTRABIDZ_ADMIN_BOOTSTRAP_EMAIL=
OPTRABIDZ_ADMIN_BOOTSTRAP_PASSWORD=
OPTRABIDZ_ADMIN_BOOTSTRAP_DISPLAY_NAME=
OPTRABIDZ_ADMIN_BOOTSTRAP_ORGANIZATION=

# Administrator recovery (enable only during an authorized maintenance window)
OPTRABIDZ_ADMIN_RECOVERY_ENABLED=false
OPTRABIDZ_ADMIN_RECOVERY_TOKEN=

# Development payment adapters
OPTRABIDZ_LOCAL_PROVIDER_ENABLED=false
OPTRABIDZ_SANDBOX_PROVIDERS_ENABLED=false

# Development webhook providers
OPTRABIDZ_UPI_WEBHOOK_ENABLED=false
OPTRABIDZ_UPI_WEBHOOK_SECRET=
OPTRABIDZ_CARD_WEBHOOK_ENABLED=false
OPTRABIDZ_CARD_WEBHOOK_SECRET=
